# =============================================================================
# Construction Site Management System (CSMS) — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://csms_user:csms_password@localhost:5432/csms_db

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME="Construction Site Management System"
VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# For Flutter mobile: set to your dev machine IP or use ["*"] for development.
# Example: ALLOWED_ORIGINS=["http://localhost:3000","http://192.168.1.100:3000"]
ALLOWED_ORIGINS=["*"]

# Initial admin seeding info
SEED_ADMIN_PHONE=03000000000
SEED_ADMIN_PASSWORD=Admin@123456